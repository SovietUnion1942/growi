# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
node_modules.*
/.pnp
.pnp.js
.pnpm-store

# testing
coverage

# nas-file-storage chunked-upload scratch dir (created cwd-relative when
# GROWI_NAS_ROOT is unset, e.g. by tests touching the default registry)
.growi-nas-tmp/

# misc
.DS_Store
*.pem
.Trash-*
ehthumbs.db
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# typescript
*.tsbuildinfo

# Terraform
**/.terraform/*
*.tfstate.*
/aws/

# IDE, dev #
.idea
**/.claude/settings.local.json
*.orig
*.code-workspace
*.timestamp-*.mjs

# UTCP configuration file
.utcp_config.json

# turborepo
.turbo

# pnpm deploy target dir
out

.devcontainer/compose.extend.yml

# Memory profiling artifacts (heap snapshots are large and may contain sensitive data)
*.heapsnapshot
/tmp/memory-profiler/
/tmp/memory-leak-investigation/
