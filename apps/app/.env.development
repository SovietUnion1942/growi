ELASTICSEARCH_REJECT_UNAUTHORIZED=true
OGP_URI="http://ogp:8088"
VAULT_ENABLED=true
VAULT_MANAGER_ENDPOINT=http://localhost:3001
VAULT_MANAGER_INTERNAL_SECRET=changeme-dev-secret
